# ecomsbd — environment contract (master spec section 68)
#
# DEVELOPMENT. Variable NAMES only; never commit a real secret to this file.
# Copy to backend/.env for local development; local defaults are sufficient to
# boot with nothing set except APP_ENV and DATABASE_URL.
#
# For PRODUCTION use .env.production.example and docs/PRODUCTION_ENV_SETUP.md.
# That file is the authoritative production template; this one exists so a
# developer can start the stack in one command.
#
# Startup FAILS FAST in staging/production if any secret below is missing or
# still holds a development placeholder.

# ---------------------------------------------------------------- application
APP_ENV=local                      # local | test | staging | production
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_WEB_URL=
SUPPORT_EMAIL=
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------------------- database
# PostgreSQL in every real environment (Supabase is the managed host).
DATABASE_URL=postgresql+asyncpg://ecomsbd:ecomsbd@localhost:5432/ecomsbd
DATABASE_ECHO=false

# ---------------------------------------------------------------------- redis
# Optional in local/test only; the API falls back to an in-process cache.
# REQUIRED in staging/production, and required for the worker anywhere.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------ auth keys
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
JWT_KEY_VERSION=v1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# ------------------------------------------------------------------- crypto
# Courier/billing credential vault. Base64 of exactly 32 random bytes:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=v1

# Separate secret. Keyed HMAC for exact phone lookup (master spec section 133).
# A leak of this key must not also compromise OTP or session hashing.
PHONE_SEARCH_HMAC_KEY=

# -------------------------------------------------------- sign-in methods
# BOOT config, not runtime feature flags. All four backend methods work.
# Local OTP defaults remain convenient for existing development clients;
# .env.production.example enables email/password, Google and Apple without SMS.
PHONE_OTP_LOGIN_ENABLED=true
EMAIL_PASSWORD_AUTH_ENABLED=false
GOOGLE_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false

# Public OAuth client ids — not secrets; they ship inside the app.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=

# Sign in with Apple. APPLE_PRIVATE_KEY is the .p8 *contents*, never a path.
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ------------------------------------------------------------------- email
# disabled | console | mock | provider_api.
# `console` prints the message instead of sending it — useful locally, and
# refused at startup in staging/production because a reset link is a credential.
EMAIL_TRANSPORT=disabled
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ecomsbd
EMAIL_API_BASE_URL=
EMAIL_API_KEY=

# ---------------------------------------------------------------------- OTP
# Only read when PHONE_OTP_LOGIN_ENABLED=true.
# dev_console never sends an SMS and writes the code to the log.
# It is REFUSED at startup when APP_ENV=production.
OTP_PROVIDER=dev_console           # dev_console | sms_gateway
OTP_PROVIDER_SECRET=
OTP_HASH_SECRET=
ALLOW_DEV_OTP=true                 # MUST be false in production
OTP_EXPOSE_DEBUG_CODE=true         # MUST be false in production
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_PHONE_HOUR=5
OTP_MAX_REQUESTS_PER_IP_HOUR=20
OTP_RESEND_COOLDOWN_SECONDS=60

# --------------------------------------------------------------- observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ---------------------------------------------------------- object storage (R2)
# UNVERIFIED: not provisioned yet. Used for payout source files and exports.
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------- FCM
# UNVERIFIED: not provisioned yet.
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# ---------------------------------------------------------------------- worker
WORKER_QUEUE_NAME=ecomsbd:jobs
WORKER_MAX_JOBS=10
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=12

# ------------------------------------------------------------------------- API
# Comma-separated or a JSON array; blank means empty. A deployed environment
# refuses "*", any localhost origin, and (in production) plain http.
CORS_ALLOW_ORIGINS=
# Host headers this deployment answers to. Empty disables the check, which is
# right locally and behind a host-checking proxy. "*" is refused in production.
TRUSTED_HOSTS=
DEFAULT_PAGE_SIZE=30
MAX_PAGE_SIZE=100
MINIMUM_SUPPORTED_APP_VERSION=

# ------------------------------------- NOT YET CONFIGURABLE (later phases only)
# Courier, billing and SMS credentials are deliberately absent. Each one is
# added when its provider capability manifest has been verified against real
# merchant documentation (master spec sections 74, 140):
#
#   Steadfast   - phase C   backend/app/couriers/manifests/steadfast.yaml
#   Pathao/RedX - phase 7/8
#   Google Play - phase F   package name + service account
#   bKash       - phase F   merchant onboarding contract
#   SMS gateway - phase E   sender ID + segment/cost rules
