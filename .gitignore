# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
htmlcov/
.coverage

# Local databases
*.db
*.db-journal
*.sqlite3

# Operator-supplied provider documentation, as delivered.
#
# These arrive unredacted — the Steadfast V1 export carries literal example
# API key and secret values in its PHP snippet. The *sanitized, redacted* copy
# is what gets committed, under docs/providers/<provider>/. Keeping the raw
# original ignored means a future drop cannot be staged by reflex.
/API Documentation.html
/API Documentation_files/
/provider-docs-inbox/

# Secrets — never commit. The committed *.example files carry the variable
# names and nothing else; the negations below are what keeps them visible after
# the `.env.*` sweep, and each one is a file this repository asserts is safe.
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
# Sign in with Apple signing keys. A .p8 is issued once and cannot be
# re-downloaded, which makes "I'll just keep it in the repo for now" a
# tempting and permanent mistake.
*.p8
service-account*.json
firebase-admin*.json
google-services.json
GoogleService-Info.plist

# Flutter / Dart
apps/mobile_flutter/.dart_tool/
apps/mobile_flutter/build/
apps/mobile_flutter/.flutter-plugins
apps/mobile_flutter/.flutter-plugins-dependencies
apps/mobile_flutter/android/.gradle/
apps/mobile_flutter/android/build/
apps/mobile_flutter/android/local.properties
key.properties
# Filled-in Flutter build configuration. The .example next to it is committed.
apps/mobile_flutter/env/*.json
!apps/mobile_flutter/env/*.example.json
apps/mobile_flutter/**/*.g.dart
apps/mobile_flutter/**/*.freezed.dart
*.jks
*.keystore

# Build artefacts
*.apk
*.aab
*.symbols

# Editors / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
