# ============================================================
# ECOMSBD - PRODUCTION ENVIRONMENT
# ============================================================
#
# This file is COMMITTED and must never hold a real value.
# Copy it to .env.production.local (gitignored) and fill that in:
#
#     cp .env.production.example .env.production.local
#
# Then check your work without printing a single secret:
#
#     cd backend && python -m app.check_production_config \
#         --env-file ../.env.production.local --env production
#
# Every credential is explained - where to get it, where to paste it, how to
# verify it - in docs/PRODUCTION_ENV_SETUP.md. Work through that document
# provider by provider; this file is the shape, that one is the instructions.
#
# HOW THIS FILE REACHES THE SERVER. The backend reads `.env` relative to its own
# working directory (backend/), so this file does not load itself. Either hand
# it to your runtime as an env file (Compose `env_file:`, a Kubernetes Secret
# via `envFrom`, your platform's secret store) or copy it to backend/.env on
# the host, mode 600. Real environment variables always win over a file.
#
# Every variable carries one of:
#   # REQUIRED                       the process refuses to start without it
#   # REQUIRED WHEN <condition>      needed only when that feature is on
#   # OPTIONAL                       safe to leave blank; the effect is stated
#
# A blank line means "not set". The application reads it that way on purpose,
# so you can leave anything you have not obtained yet exactly as it is.
#
# NOT IN THIS FILE, deliberately:
#   * Seller courier credentials. Each shop's Steadfast Api-Key/Secret-Key is
#     entered in the app and stored encrypted per courier account. One global
#     key here would mean every shop's parcels booked on one merchant account.
#   * Runtime feature flags (steadfast_enabled, play_billing_enabled, ...).
#     Those live in the feature_flags table and are changed without a deploy.
#     See "BOOT CONFIG vs RUNTIME FLAG" in docs/PRODUCTION_ENV_SETUP.md.
#   * The Android package id and signing key. Those belong to Gradle, not here.


# ============================================================
# APP
# ============================================================

# REQUIRED - selects every production guard in app/core/config.py.
APP_ENV=production

# REQUIRED - must be false. Staging and production refuse to start otherwise.
DEBUG=false

# OPTIONAL - product name. Locked; change only if the product is renamed.
APP_NAME=ecomsbd

# REQUIRED - public https origin of this API, no trailing slash.
# Production refuses http:// and refuses localhost.
# Format: https://api.yourdomain.com
PUBLIC_BASE_URL=https://api.scalemyprints.com

# OPTIONAL - base for links inside transactional email, once a web surface
# exists. There is no web client today. Must be https in production.
PUBLIC_WEB_URL=

# OPTIONAL - reply-to on outbound mail and the address shown to a seller who
# needs help. Use a mailbox a person actually reads.
SUPPORT_EMAIL=

# OPTIONAL - business timezone. Business dates, the Friday summary and every
# COD ageing window are computed in it. Do not change without reading
# master spec section 69.
DEFAULT_TIMEZONE=Asia/Dhaka

# OPTIONAL - URL prefix for the versioned API.
API_V1_PREFIX=/v1

# OPTIONAL - CRITICAL | ERROR | WARNING | INFO | DEBUG.
LOG_LEVEL=INFO

# OPTIONAL - structured JSON log lines. Leave true wherever logs are shipped.
LOG_JSON=true


# ============================================================
# DATABASE
# ============================================================

# REQUIRED - PostgreSQL, asyncpg driver. Supabase is the managed host.
# Use the SESSION POOLER / transaction pooler connection string, not the
# direct one, and translate its scheme to postgresql+asyncpg://.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/postgres
# See PRODUCTION_ENV_SETUP.md section 2 for the pooler caveats.
DATABASE_URL=

# OPTIONAL - echo every statement to the log. Never true in production: it
# prints query parameters, which include customer data.
DATABASE_ECHO=false

# OPTIONAL - connection pool. Keep pool+overflow below the pooler's per-client
# limit; Supabase's transaction pooler is stricter than it looks.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30


# ============================================================
# REDIS / WORKERS
# ============================================================

# REQUIRED - rate limits, idempotency, locks and the ARQ job queue.
# The API refuses to start without it outside local/test, and the worker
# refuses outright: a worker with no Redis silently processes nothing.
# Format: redis://:PASSWORD@HOST:PORT/0   or   rediss://... over TLS.
# Use rediss:// unless the hop to Redis is inside a private network.
REDIS_URL=

# OPTIONAL - worker tuning.
WORKER_QUEUE_NAME=ecomsbd:jobs
WORKER_MAX_JOBS=10
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=12


# ============================================================
# SECURITY / CRYPTO
# ============================================================
# Required, independent business security keys. Preserve existing values.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=v1
PHONE_SEARCH_HMAC_KEY=
# REQUIRED - preserve the existing backend platform-admin token-hashing key.
# The legacy name remains for hash compatibility. It cannot issue seller sessions.
JWT_SIGNING_KEY=

# ============================================================
# SUPABASE AUTH - sole seller authentication authority
# ============================================================
# REQUIRED - HTTPS project origin; issuer and JWKS are derived from this URL.
SUPABASE_URL=
# REQUIRED - public anon/publishable key; also allowed in Flutter.
SUPABASE_ANON_KEY=
# BACKEND ONLY - required when executing final account/privacy deletion.
# Not required just to start the API or verify JWTs.
SUPABASE_SERVICE_ROLE_KEY=

# Google/Apple providers, email confirmation, password/reset policy and SMTP
# are configured in Supabase Dashboard, not in FastAPI.
# Public native Google IDs belong in Flutter env/production.json.
# Phone login cannot be enabled in production.
PHONE_OTP_LOGIN_ENABLED=false
ALLOW_DEV_OTP=false
OTP_EXPOSE_DEBUG_CODE=false

# ============================================================
# BUSINESS EMAIL - independent of Supabase auth email
# ============================================================
# Optional; enable only for business email after supplying sender credentials.
EMAIL_TRANSPORT=disabled
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ecomsbd
EMAIL_API_BASE_URL=
EMAIL_API_KEY=
# Resend webhook signing secret (whsec_...) for customer-message delivery,
# bounce and complaint receipts. Optional; without it statuses stop at SENT.
EMAIL_WEBHOOK_SECRET=

# ============================================================
# BUSINESS SMS (optional; seller phone login is disabled)
# ============================================================
# Only required if a business SMS transport is configured.
OTP_PROVIDER_SECRET=

# ============================================================
# STEADFAST / COURIERS
# ============================================================
#
# There is no merchant credential in this file, by design.
#
#   PLATFORM CONFIG (here)      base URL, batch size, webhook gate, timeouts
#   MERCHANT CREDENTIALS (not)  each seller enters their own Api-Key and
#                               Secret-Key in Settings -> Courier accounts;
#                               both are AES-256-GCM encrypted per account row
#                               and never leave the server.
#   ROLLOUT (not)               the `steadfast_enabled` runtime feature flag,
#                               in the database, changed without a deploy.
#
# For a one-off operator smoke test against a live merchant account, the tool
# reads STEADFAST_SMOKE_API_KEY and STEADFAST_SMOKE_SECRET_KEY from the shell -
# exported for that command only, never written into this file:
#
#     python -m app.provider_smoke steadfast --env-credentials

# OPTIONAL - the URL Steadfast's V1 documentation prints. Overridable so a
# future sandbox does not need a release; no sandbox is documented today.
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1

# OPTIONAL - our own bulk chunk. The provider permits 500; a failed 500-item
# request leaves 500 parcels in an unknown state.
STEADFAST_BULK_CHUNK_SIZE=50

# REQUIRED - must stay false. STEADFAST_WEBHOOK_CONTRACT_REQUIRED: the supplied
# V1 documentation has no webhook section, so there is no signature scheme to
# verify. Accepting deliveries unauthenticated would let anyone mark a parcel
# delivered and move a seller's money. Startup refuses true in staging and
# production. Polling is the complete synchronisation path.
STEADFAST_WEBHOOK_ENABLED=false

# OPTIONAL - courier HTTP budgets. The short, separate connect timeout is what
# makes an ambiguous booking a clean failure instead of an untraceable parcel.
COURIER_CONNECT_TIMEOUT_SECONDS=5.0
COURIER_READ_TIMEOUT_SECONDS=20.0
COURIER_WRITE_TIMEOUT_SECONDS=10.0
COURIER_POOL_TIMEOUT_SECONDS=5.0
COURIER_MAX_CONNECTIONS=10
COURIER_READ_RETRIES=2

# OPTIONAL - adaptive status polling, in minutes/hours/days.
COURIER_POLL_INTERVAL_FRESH_MINUTES=20
COURIER_POLL_INTERVAL_ACTIVE_MINUTES=60
COURIER_POLL_INTERVAL_STALE_MINUTES=360
COURIER_POLL_FRESH_WINDOW_HOURS=24
COURIER_POLL_ACTIVE_WINDOW_DAYS=7
COURIER_POLL_BATCH_SIZE=100

# OPTIONAL - BOOKING_UNKNOWN recovery backoff.
COURIER_RECOVERY_INITIAL_DELAY_SECONDS=60
COURIER_RECOVERY_MAX_DELAY_SECONDS=3600
COURIER_RECOVERY_MAX_ATTEMPTS=8

# OPTIONAL - courier payment sync. The overlap re-reads a little of what was
# already seen; duplicates are free, a gap is money the seller never sees.
COURIER_PAYMENT_SYNC_INTERVAL_MINUTES=60
COURIER_PAYMENT_SYNC_OVERLAP_MINUTES=120
COURIER_PAYMENT_SYNC_MAX_PAGES=20


# ============================================================
# OBJECT STORAGE / R2
# ============================================================
# Private R2 stores original imports/payout files and generated exports.
# Existing inline records remain readable. No public object URLs are issued.
# Configure all four application values when using R2.
# Create an R2 API token scoped to THIS BUCKET with Object Read & Write only.
# The bucket must not be publicly writable, and needs no public read access.

# REQUIRED WHEN R2 IS USED - includes your account id.
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# REQUIRED WHEN R2 IS USED - production bucket: ecomsbd-production
R2_BUCKET=

# REQUIRED WHEN R2 IS USED - SECRET, shown once at token creation.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OPTIONAL - export download policy. Downloads are served through the API with
# a single-use, expiring token; no public bucket URL is involved.
EXPORT_MAX_SYNC_ROWS=2000
EXPORT_DOWNLOAD_TTL_SECONDS=900
EXPORT_MAX_ACTIVE_PER_TENANT=3


# ============================================================
# FIREBASE / FCM
# ============================================================
# FCM_CREDENTIALS_REQUIRED. Backend sending only. The MOBILE side of Firebase
# is a different artifact: google-services.json goes at
# apps/mobile_flutter/android/app/google-services.json and is NOT an env var.
#
# Push is a second copy of information already in the notification centre
# (master spec section 94), so the product works without it. With
# PUSH_TRANSPORT=disabled every attempt is recorded as NOT_CONFIGURED rather
# than reported as sent.

# REQUIRED - disabled | fcm. `mock` is refused outside local/test.
PUSH_TRANSPORT=disabled

# REQUIRED WHEN PUSH_TRANSPORT=fcm - Firebase project id.
FCM_PROJECT_ID=

# REQUIRED WHEN PUSH_TRANSPORT=fcm - SECRET. The service-account JSON as a
# single-line string, not a file path. Never commit the file: service-account*.json
# and firebase-admin*.json are gitignored.
FCM_CREDENTIALS_JSON=

# REQUIRED - disabled | sms_gateway. `mock` is refused outside local/test.
SMS_TRANSPORT=disabled

# OPTIONAL - delivery retry ceiling for the notification dispatcher.
NOTIFICATION_MAX_ATTEMPTS=5


# ============================================================
# SENTRY
# ============================================================
# Optional but strongly recommended: without it, a crash in a seller's hands is
# invisible. Absence never stops the boot.
#
# Already handled in code: send_default_pii=False and a before_send scrubber
# that runs the same redaction as the logs, so customer phone numbers, API
# keys, courier secrets and Authorization headers do not reach Sentry.

# OPTIONAL - SECRET-ish. A backend DSN can send events; keep it out of clients.
# Format: https://<key>@o000000.ingest.sentry.io/0000000
SENTRY_DSN=

# OPTIONAL - tag on every event. Defaults to APP_ENV.
SENTRY_ENVIRONMENT=production

# OPTIONAL - which build an event came from. Without it every regression looks
# like it has always been there. Defaults to ecomsbd-backend@<version>.
# Format: ecomsbd-backend@0.1.0  or the deployed commit sha.
SENTRY_RELEASE=

# OPTIONAL - performance tracing sample rate, 0.0-1.0. Start at 0.0 and raise
# deliberately; traces are billed.
SENTRY_TRACES_SAMPLE_RATE=0.0


# ============================================================
# GOOGLE PLAY BILLING
# ============================================================
# PLAY_SERVICE_ACCOUNT_REQUIRED. Keep the `play_billing_enabled` runtime flag
# OFF until all four prerequisites hold:
#   1. final package id: com.ecomsbd.app (matches Play Console)
#   2. the app exists in Play Console
#   3. a service account with Play Developer API access
#   4. subscription products created and mapped below
#
# A verifier missing any of these cannot tell a genuine purchase from a
# fabricated token, so the provider reports itself unconfigured instead.

# REQUIRED WHEN PLAY BILLING IS USED - must match the Gradle applicationId
# exactly. Anything under com.example is rejected.
PLAY_PACKAGE_NAME=com.ecomsbd.app

# REQUIRED WHEN PLAY BILLING IS USED - SECRET. Service-account JSON as a
# single-line string. Never a path, never committed.
PLAY_SERVICE_ACCOUNT_JSON=

# REQUIRED WHEN PLAY BILLING IS USED - JSON map of Play product id -> plan code.
# Format: {"ecomsbd_starter_monthly":"starter","ecomsbd_pro_monthly":"pro"}
PLAY_PRODUCT_PLAN_MAP=

# OPTIONAL - SECRET. Shared secret for Real-time Developer Notifications.
PLAY_RTDN_SHARED_SECRET=

# REQUIRED - PLAY | WEB | DIRECT | INTERNAL_TEST. Decides whether an
# out-of-app payment CTA may be shown at all (master spec section 27.1).
# Set PLAY once the build is shipped through Play.
DISTRIBUTION_CHANNEL=DIRECT


# ============================================================
# BKASH
# ============================================================
# BKASH_MERCHANT_SETUP_REQUIRED. Leave every line blank until merchant
# onboarding completes and you have the documentation for the products your
# merchant account is actually granted. No endpoint path is hard-coded.
#
# All five or none: a partly-configured merchant is refused at startup.
# There is no BKASH_ENABLED variable - the kill switch is the
# `bkash_web_billing_enabled` runtime flag, which is off by default.

# REQUIRED WHEN BKASH IS USED - from your merchant documentation.
BKASH_BASE_URL=

# REQUIRED WHEN BKASH IS USED - SECRET.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# OPTIONAL - SECRET. Callback signature secret, when your contract defines one.
BKASH_WEBHOOK_SECRET=


# ============================================================
# BILLING POLICY
# ============================================================
# Product-validation data, not technical constants: changeable without a
# release (master spec section 26).

# OPTIONAL - JSON, plan code -> price in paisa. Empty uses the shipped catalog.
# Format: {"starter":24900,"pro":39900}
PLAN_PRICE_OVERRIDES=

# OPTIONAL - JSON, plan code -> entitlement overrides.
# Format: {"pro":{"sms_segments_monthly":2000}}
PLAN_ENTITLEMENT_OVERRIDES=

# OPTIONAL - dunning window after a failed renewal. Deliberately generic:
# neither Play's nor bKash's real retry schedule has been verified.
BILLING_GRACE_PERIOD_DAYS=3
BILLING_MAX_PAYMENT_RETRIES=3
BILLING_RETRY_INTERVAL_HOURS=24

# OPTIONAL - 0 disables the trial. No trial until pricing is validated.
BILLING_TRIAL_DAYS=0


# ============================================================
# ADMIN / OPS
# ============================================================
# Platform admin is a separate identity from any seller account. With nothing
# configured there is no admin access at all - which is the correct posture,
# not an omission.
#
# PREFER provisioning individual `platform_admins` rows: those carry a role,
# are revocable without a redeploy, and name the operator in every audit entry.
# A bootstrap token below is a SHARED credential that audits only as
# "bootstrap:0" and cannot be revoked without redeploying. Use one to create
# the first real admin, then remove it.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters; shorter or placeholder values are refused at startup.

# OPTIONAL - SECRET. Comma-separated, or a JSON array. Leave blank in steady state.
ADMIN_API_TOKENS=

# OPTIONAL - how long a support "reveal customer PII" grant lasts.
ADMIN_REVEAL_TTL_SECONDS=300


# ============================================================
# CORS / TRUSTED HOSTS / URLS
# ============================================================
# Comma-separated, or a JSON array. Blank means empty.
#
# Refused at startup in staging/production: "*", any localhost/127.0.0.1
# origin, and (in production) any plain-http origin. The API is served with
# allow_credentials=True, so a wildcard origin would let any site make
# authenticated requests on a seller's behalf.
#
# The mobile app is not a browser and needs NO CORS entry. Leave this blank
# unless a browser client actually exists.

# OPTIONAL - browser origins allowed to call this API, with scheme, no path.
# Format: https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ALLOW_ORIGINS=

# OPTIONAL BUT RECOMMENDED - Host headers this deployment answers to. Empty is
# correct only behind a proxy that already enforces the host; "*" is refused in
# production. Format: api.yourdomain.com
TRUSTED_HOSTS=

# OPTIONAL - clients older than this are refused with a stable upgrade error.
# Set once more than one build is in the wild. Format: 1.2.0
MINIMUM_SUPPORTED_APP_VERSION=

# OPTIONAL - request and pagination limits.
REQUEST_BODY_LIMIT_BYTES=2097152
DEFAULT_PAGE_SIZE=30
MAX_PAGE_SIZE=100


# ============================================================
# FEATURE FLAGS / PROVIDERS  --  NO VARIABLES HERE, ON PURPOSE
# ============================================================
#
# Provider rollout is a RUNTIME feature flag in the `feature_flags` table, not
# boot configuration. Changing one takes effect on the next request; changing
# an environment variable needs a restart. During a provider outage that
# difference is the whole point.
#
#   steadfast_enabled                off    courier booking + sync
#   pathao_enabled                   off    not implemented
#   redx_enabled                     off    RedX booking + sync; enable per shop
#   play_billing_enabled             off    Play purchase verification
#   bkash_web_billing_enabled        off    bKash checkout
#   provider_auto_address            on
#   courier_recommendation_enabled   off
#   reconciliation_auto_match        off
#   reconciliation_shadow_mode       on
#   ai_parse_enabled                 off
#   risk_aggregator_fallback         off
#
# Everything provider-facing defaults to OFF: a feature that has not been
# verified against real documentation must not be reachable just because its
# row is missing. A flag can be global, per tenant, or a deterministic
# percentage rollout.
#
# Read them:   GET  /v1/admin/flags     (X-Admin-Token)
#
# The BOOT flags in this file are a different thing. Each one decides whether
# the process is safe to start at all, which is a question that must be settled
# before any database connection exists:
#
#   SUPABASE_URL, SUPABASE_ANON_KEY         -- seller authentication,
#                                                and whether anyone can sign in
#   STEADFAST_WEBHOOK_ENABLED                 -- a safety gate on an endpoint
#                                                with no signature contract;
#                                                startup refuses true
#   PUSH_TRANSPORT, SMS_TRANSPORT,
#   EMAIL_TRANSPORT                           -- which transport is constructed,
#                                                and which are refused here
#
# A runtime flag could turn the Steadfast webhook on. Boot configuration
# cannot, because startup refuses it. That is why that one is an env var.


# ============================================================
# RELEASE IDENTIFIERS  --  MOSTLY NOT ENVIRONMENT VARIABLES
# ============================================================
#
# These must be finalized before the first Play upload. Each belongs somewhere
# other than this file, and putting it here would create a second source of
# truth that silently drifts.
#
#   Android applicationId   apps/mobile_flutter/android/app/build.gradle.kts
#                           (`namespace` and `defaultConfig.applicationId`) plus
#                           the MainActivity package path.
#                           Final owner decision: com.ecomsbd.app. This id is
#                           permanent; do not substitute a scaffold default.
#
#   Android release signing apps/mobile_flutter/android/key.properties
#                           (gitignored) + the keystore, stored OUTSIDE this
#                           repository, or ECOMSBD_RELEASE_* environment values.
#                           Release builds require this config; no debug fallback.
#                           See android/RELEASE_SIGNING.md for key/fingerprint commands.
#
#   Apple bundle identifier the Xcode project and the App ID in the Apple
#                           Developer portal. Must match Supabase Apple Client IDs when
#                           the native sign-in flow is used.
#
#   version / build number  apps/mobile_flutter/pubspec.yaml -> `version:`.
#                           Play orders releases by the number after the `+`
#                           and rejects a repeat.
#
#   Google OAuth binding    the Android OAuth client is bound to the package id
#                           AND the release signing SHA-1. Neither can be
#                           registered before the two blockers above are
#                           resolved. With Play App Signing on, register the
#                           Play-side certificate SHA-1 too.
#
#   Firebase Android app    created against the package id; produces
#                           google-services.json, which goes at
#                           apps/mobile_flutter/android/app/ and is gitignored.
#
#   Play Console package    the listing is created with the final package id.
#
# The one place this crosses into the environment is PLAY_PACKAGE_NAME above,
# which must equal the Gradle applicationId exactly: Play purchase verification
# is bound to the package name and the server cannot read Gradle.
FREE_LAUNCH_MODE=true
BILLING_ENABLED=false
RISK_CHECKS_DAILY_SAFETY_LIMIT=500

# Copy a real Meta v4 Configuration ID. Enable public signup only after approval.
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
META_WHATSAPP_PUBLIC_SIGNUP_ENABLED=false
# ecomsbd user UUIDs allowed to try Meta development signup, JSON array.
META_WHATSAPP_TEST_USER_IDS=[]
# Ignored in production: manual testing requires independent platform admin auth.
META_WHATSAPP_MANUAL_ENABLED=false
