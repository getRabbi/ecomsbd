<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app-level privacy manifest. Flutter and every plugin pod that
	     ships its own manifest (Firebase, GoogleSignIn, shared_preferences,
	     file_picker, ...) are aggregated by Xcode and are not repeated here.

	     The one gap is SQLite: sqlite3_flutter_libs links the `sqlite3` pod,
	     which has no manifest, and SQLite's unix VFS calls stat/fstat on the
	     local database files (file timestamp) and statfs on their volume
	     (disk space) before writing them. Both stay inside the app container.

	     No tracking. Data collection is declared in App Store Connect's App
	     Privacy answers, not here. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
