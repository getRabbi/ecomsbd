<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs, which Firebase Messaging delivers through. Production because
	     only App Store builds are signed; the App ID has Push Notifications. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Native Sign in with Apple (lib/data/auth/provider_sign_in.dart). The
	     App ID has the capability; Supabase must list com.ecomsbd.app as an
	     Apple client id. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
